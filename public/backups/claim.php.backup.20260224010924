    <?php elseif ($step === 'done'): ?>
        <h1>Registration Complete!</h1>
        <p style="color:#10b981;margin:20px 0">Your agent is active.</p>
        <div style="background:#000;padding:20px;border-radius:8px;font-family:monospace;color:var(--red);border:1px solid var(--border)">
            <?=$ag['api_key']?>
