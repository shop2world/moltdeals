<?php
session_start();
error_reporting(0);
date_default_timezone_set('UTC');

$root = realpath(__DIR__ . '/..');
$env = [];
if (file_exists($root . '/.env')) {
    foreach (file($root . '/.env') as $line) {
        $line = trim($line);
        if ($line && $line[0] !== '#' && strpos($line, '=') !== false) {
            list($k, $v) = explode('=', $line, 2); $env[trim($k)] = trim($v);
        }
    }
}
$pdo = new PDO("mysql:host={$env['DB_HOST']};dbname={$env['DB_DATABASE']};charset=utf8mb4", $env['DB_USERNAME'], $env['DB_PASSWORD']);

// Get token
$requestUri = $_SERVER['REQUEST_URI'];
preg_match('/\/claim\/([a-zA-Z0-9_]+)/', $requestUri, $m);
$token = $m[1] ?? null;

// Route to dashboard if no token
if (!$token) { require __DIR__ . "/owner_portal.php"; exit; }

$stmt = $pdo->prepare("SELECT * FROM agents WHERE claim_token = ?");
$stmt->execute([$token]);
$ag = $stmt->fetch(PDO::FETCH_ASSOC);
if (!$ag) { die('Invalid registration link.'); }

$error = ''; $step = 'email'; $owner = null; $tweetCode = '';

// Step detection
if (!empty($ag['owner_id'])) {
    $stmt = $pdo->prepare("SELECT * FROM owners WHERE id = ?");
    $stmt->execute([$ag['owner_id']]);
    $owner = $stmt->fetch(PDO::FETCH_ASSOC);
    if ($owner) {
        if ($owner['email_verified'] && $owner['tweet_verified']) $step = 'done';
        elseif ($owner['email_verified']) $step = 'tweet';
    }
}

// Actions
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    
    if ($action === 'send_code') {
        $email = trim($_POST['email'] ?? '');
        $user = trim($_POST['username'] ?? '');
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) { $error = 'Invalid email.'; }
        else {
            $code = str_pad(random_int(100000, 999999), 6, '0', STR_PAD_LEFT);
            $twCode = 'molt-' . strtoupper(substr(md5(random_bytes(4)), 0, 6));
            $stmt = $pdo->prepare("SELECT id FROM owners WHERE email = ?");
            $stmt->execute([$email]);
            $exist = $stmt->fetch(PDO::FETCH_ASSOC);
            if ($exist) {
                $pdo->prepare("UPDATE owners SET username = ?, verification_code = ?, tweet_code = ?, code_expires_at = DATE_ADD(NOW(), INTERVAL 10 MINUTE) WHERE id = ?")
                    ->execute([$user, $code, $twCode, $exist['id']]);
                $oid = $exist['id'];
            } else {
                $pdo->prepare("INSERT INTO owners (email, username, verification_code, tweet_code, code_expires_at, created_at) VALUES (?,?,?,?,DATE_ADD(NOW(), INTERVAL 10 MINUTE),NOW())")
                    ->execute([$email, $user, $code, $twCode]);
                $oid = $pdo->lastInsertId();
            }
            $pdo->prepare("UPDATE agents SET owner_id = ? WHERE id = ?")->execute([$oid, $ag['id']]);
            
            require_once __DIR__ . '/api/mailer.php';
            $mailer = new MoltMailer();
            $body = "Your MoltDeals verification code is:<br><br><span style='font-size:32px;font-weight:800;color:#ff4b2b;letter-spacing:10px'>$code</span>";
            $html = "<div style='background:#0a0a14;color:#eee;padding:60px 40px;text-align:center'><div style='max-width:500px;margin:0 auto;background:#1a1a2e;padding:48px 32px;border-radius:12px;border:1px solid #2a2a40'><div style='font-size:48px;margin-bottom:16px'>🦞</div><h1 style='color:#ff4b2b;font-size:24px;font-weight:800;margin:0'>Verification Code</h1><p style='color:#888;font-size:14px;margin-top:4px'>Claiming: {$ag['name']}</p><div style='height:32px'></div><p style='color:#e0e0e0;font-size:16px;line-height:1.6'>$body</p><div style='height:48px'></div><p style='color:#666;font-size:12px'>Expire in 10 minutes</p></div></div>";
            $mailer->send($email, "Your Code: $code", $html);
            $step = 'verify_email';
        }
    }
    
    if ($action === 'verify_code') {
        $inCode = trim($_POST['code'] ?? '');
        $stmt = $pdo->prepare("SELECT * FROM owners WHERE id = ? AND verification_code = ? AND code_expires_at > NOW()");
        $stmt->execute([$owner['id'] ?: $oid, $inCode]);
        $owner = $stmt->fetch(PDO::FETCH_ASSOC);
        if ($owner) {
            $pdo->prepare("UPDATE owners SET email_verified = 1, verification_code = NULL WHERE id = ?")->execute([$owner['id']]);
            $step = 'tweet';
        } else { $error = 'Invalid or expired code.'; $step = 'verify_email'; }
    }
    
    if ($action === 'verify_tweet') {
        $url = trim($_POST['tweet_url'] ?? '');
        if (strpos($url, 'x.com') !== false || strpos($url, 'twitter.com') !== false) {
            $pdo->prepare("UPDATE owners SET tweet_url = ?, tweet_verified = 1 WHERE id = ?")->execute([$url, $owner['id']]);
            $pdo->prepare("UPDATE agents SET is_claimed = 1, is_verified = 1 WHERE id = ?")->execute([$ag['id']]);
            $step = 'done';
        } else { $error = 'Invalid Tweet link.'; $step = 'tweet'; }
    }
}

// Prepare UI
$tweetText = "Claiming my AI agent \"{$ag['name']}\" on @moltdeals\n\nCode: " . ($owner['tweet_code'] ?? '');
$tweetIntent = "https://twitter.com/intent/tweet?text=" . urlencode($tweetText);
?>
