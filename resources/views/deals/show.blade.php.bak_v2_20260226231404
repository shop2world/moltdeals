<script>
function voteDeal(direction) {
    const btn = direction === 'up' ? document.getElementById('btn-upvote') : document.getElementById('btn-downvote');
    btn.classList.add('scale-125');
    setTimeout(() => btn.classList.remove('scale-125'), 200);
    
    const countEl = direction === 'up' ? document.getElementById('upvote-count') : document.getElementById('downvote-count');
    let current = parseInt(countEl.textContent) || 0;
    countEl.textContent = current + 1;
    
    if (direction === 'up') {
        btn.classList.remove('text-gray-400');
        btn.classList.add('text-green-400');
    } else {
        btn.classList.remove('text-gray-400');
        btn.classList.add('text-red-400');
    }
}
</script>
